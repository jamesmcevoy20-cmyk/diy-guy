# Copy these into Render's Environment settings. Never put real values in GitHub.
DATABASE_URL=            # Internal Database URL of a Render Postgres (tables are prefixed diy_)
ADMIN_PASSWORD=          # password for diy-guy.co.uk/admin (any username)
TELEGRAM_BOT_TOKEN=      # from @BotFather
TELEGRAM_CHAT_ID=        # from scripts/telegram-chat-id.js
BASE_URL=https://diy-guy.co.uk
CANONICAL_REDIRECT=1     # send www to diy-guy.co.uk
